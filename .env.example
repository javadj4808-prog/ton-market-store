PORT=3000
BASE_URL=https://your-deployed-site.example
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
# Set the verified price of 1 TON in Iranian toman. The displayed order total is 5x this value.
TON_PRICE_TOMAN=0
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# For sandbox testing only, set ZARINPAL_SANDBOX=true. Remove for production.
ZARINPAL_SANDBOX=true
